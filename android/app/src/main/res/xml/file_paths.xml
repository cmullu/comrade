<?xml version="1.0" encoding="utf-8"?>
<!-- Exposes app-private cache files (decrypted media attachments — see
     MediaAttachment.kt) to other apps via a content:// URI, scoped to the
     one subdirectory those files are ever written into. -->
<paths>
    <cache-path name="media" path="media/" />
    <!-- Where the composer's camera captures are written, so the camera app can
         write into them. Separate from media/ because purgeDecryptedMedia sweeps
         that directory and must not race a capture still being written. -->
    <cache-path name="capture" path="capture/" />
    <!-- Where the camera writes a video journal recording while it is still
         recording it. Its own directory, and deliberately NOT the journal's
         own folder under filesDir: the camera app is another app, and the only
         thing it is ever granted is the one file it is writing. The finished
         recording is moved into filesDir/journal-videos by
         JournalVideoStore.adopt, which no other app can reach at all. -->
    <cache-path name="journal-capture" path="journal-capture/" />
    <!-- Where a large attachment handed straight over by a peer lands, so the
         person it was sent to can open it in whatever app handles its type. Its
         own directory because that is what makes AttachmentHandoffManager's purge
         a single sweep (AUDIT S-4) rather than a search for files by name. -->
    <cache-path name="attachment-handoff" path="attachment-handoff/" />
</paths>

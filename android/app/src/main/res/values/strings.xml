    <!-- Encryption-details dialog -->
    <string name="encryption_title">Encryption details</string>
    <string name="encryption_body">Messages in this chat are sealed with your key and theirs (NIP-44) and gift-wrapped, so relays carry neither the text nor who is talking to whom. Nobody without one of the two private keys can read it — not a relay, not us.</string>
    <string name="encryption_key_label">Their public key</string>
    <string name="encryption_verify_hint">Names are claims; this key is the identity. Compare it with them over a channel you already trust to be certain who you\'re talking to.</string>
    <!-- Block-confirmation dialog -->
    <string name="block_title">Block this person?</string>
    <string name="block_body">Their future messages will be dropped before they reach you, and this chat leaves your list. They are not told. You can start a new chat with their key later.</string>
    <string name="block_confirm">Block</string>
    <string name="cancel">Cancel</string>
    <string name="close">Close</string>


    <string name="settings_updates_auto_title">Check for updates automatically</string>
    <string name="settings_updates_auto_summary">Asks github.com once a day whether a newer Comrade has been published. That tells GitHub your IP address and nothing else — no account, no identifier, no message data. With this off, nothing is checked until you tap “Check now”.</string>

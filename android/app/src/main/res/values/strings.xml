    <string name="settings_turn_clear">Clear</string>
    <string name="settings_turn_configured">Relay configured: %1$s</string>
    <string name="settings_turn_not_configured">No relay configured — calls that can’t connect directly will fail instead of falling back</string>
    <string name="settings_turn_test">Test relay connectivity</string>
    <string name="settings_turn_test_relay_available">Relay reachable — calls can fall back to it if a direct path fails</string>
    <string name="settings_turn_test_relay_unavailable">Relay unreachable — check the server URL and credentials</string>
    <string name="settings_turn_test_no_server">No relay configured to test</string>


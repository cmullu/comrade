    <!-- Attention: the gentle stop on the feed (docs/ATTENTION.md phase 0).
         Deliberately quotes no duration and no count: a number here would
         invite a score, and this card is an offer, not a verdict. -->
    <string name="gentle_stop_title">Still here with you</string>
    <string name="gentle_stop_body">You\'ve been reading a while. Nothing wrong with that — but if you came here to feel better rather than to catch up, there might be a kinder way to spend the next ten minutes.</string>
    <string name="gentle_stop_write">Write instead</string>
    <string name="gentle_stop_breathe">Take a breath</string>
    <string name="gentle_stop_keep_reading">Keep reading</string>

    <!-- Attention: quiet hours -->
    <string name="settings_quiet_hours_title">Quiet hours</string>
    <string name="settings_quiet_hours_summary">Silences Comrade\'s notifications overnight — messages, requests, comrades coming online, update notices. A ringing call always comes through: someone calling at 3am may be exactly who this app is for. Nothing is lost, only delayed until morning.</string>
    <string name="settings_quiet_hours_window">Quiet from %1$s to %2$s</string>
    <string name="settings_quiet_hours_start">Start</string>
    <string name="settings_quiet_hours_end">End</string>
    <string name="settings_quiet_hours_device_only">Set on this device only — Comrade has no server to sync it through.</string>

    <!-- Attention: the usage mirror (phase 1). Opt-in, and the explainer says
         exactly what is read and where it goes. -->
    <string name="mirror_title">Your day so far</string>
    <string name="mirror_enable_title">See your own screen time</string>
    <string name="mirror_enable_body">Android can tell Comrade how long your screen was on, how often you picked the phone up, and how long you spent in apps you choose to mark. Comrade keeps three numbers a day — that\'s all — sealed in the same encrypted store as your journal. It never leaves this phone; there is no server to send it to. You can turn the permission off again whenever you like.</string>
    <string name="mirror_enable_action">Choose in system settings</string>
    <string name="mirror_enable_not_now">Not now</string>
    <string name="mirror_screen_time">%1$s on screen</string>
    <string name="mirror_pickups">%1$d pickups</string>
    <string name="mirror_doom_time">%1$s in apps you marked</string>
    <string name="mirror_vs_median">Your usual is about %1$s.</string>
    <string name="mirror_no_baseline">No usual yet — a few more days and this can compare you only to yourself.</string>
    <string name="mirror_pick_apps">Choose which apps to count</string>
    <string name="mirror_pick_apps_title">Which apps pull you in?</string>
    <string name="mirror_pick_apps_body">Your call entirely — Comrade ships no list of “bad apps”, because which ones are a problem is yours to say and nobody else\'s. Marked apps get their own line in the mirror.</string>
    <string name="mirror_pick_apps_none">Nothing marked yet.</string>
    <string name="mirror_not_a_score">These are your own numbers next to your own recent days. Not a score, not a target, and not compared to anyone else.</string>
    <string name="mirror_trend_title">The last few weeks</string>


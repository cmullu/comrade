    <!-- Attention: the tab and its honesty gate -->
    <string name="attention_tab">Focus</string>
    <string name="attention_explainer_title">About Focus</string>
    <string name="attention_explainer_body">These tools are for practising attention, not for fixing it, and Comrade will not pretend otherwise. There is decent evidence that using your phone more deliberately, reading longer things, and sleeping better all help you concentrate — and no good evidence that any app “restores” anyone\'s brain. So you\'ll find no scores here, no levels, and nothing telling you that you failed. Everything stays on this phone.</string>
    <string name="attention_explainer_ok">Got it</string>
</resources>

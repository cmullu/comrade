        <item quantity="other">%1$d conversations are muted (on this device).</item>
    </plurals>
    <string name="settings_notifications_unmute_all">Unmute all</string>
    <string name="settings_notifications_mute_scope">Muting is stored on this device only — Comrade has no server to sync it through, and a muted chat still shows its unread count and still rings for calls.</string>

